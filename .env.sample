# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_PRIVATE_CHANNEL_ID=C1234567890
# Only analyze people who join these channels (comma separated). Empty = any public channel
WATCH_CHANNEL_IDS=

# Analysis queue
REANALYZE_AFTER_DAYS=30
ANALYSIS_CONCURRENCY=2
ANALYSIS_MAX_ATTEMPTS=3

# LLM Configuration
# Provider is one of: groq, gemini, openrouter, ollama, openai
# Leave it empty to use whichever API key below is set (falls back to a local ollama)
LLM_PROVIDER=
# Optional, every provider has a sensible default model
LLM_MODEL=

# Free tiers: https://console.groq.com/keys, https://aistudio.google.com/apikey, https://openrouter.ai/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama runs locally for free, no key needed
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI compatible server (LM Studio, vLLM, Together...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# Database Configuration (Render.com PostgreSQL)
DATABASE_URL=your-db-external-url
# Set to false for a local postgres without SSL
DATABASE_SSL=true

# Company Information (optional)
COMPANY_NAME=Your Company Name
COMPANY_PRODUCT=Your Commercial Product Name
# Who you sell to, the model scores against this
COMPANY_ICP=Engineering leaders at B2B SaaS companies with 50-500 employees

# Research (optional) - a token with no scopes raises the GitHub search limit from 10 to 30/min
GITHUB_TOKEN=

# Environment
NODE_ENV=development
PORT=3000
